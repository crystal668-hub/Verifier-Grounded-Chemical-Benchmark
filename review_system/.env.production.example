REVIEW_ENVIRONMENT=production
REVIEW_ADMIN_USER=admin
REVIEW_ADMIN_PASSWORD=set-only-for-initialization-or-password-reset
REVIEW_SECRET_KEY=replace-with-at-least-32-random-bytes
REVIEW_COOKIE_SECURE=true
REVIEW_AUTO_CREATE_DB=false
REVIEW_DATA_DIR=/app/review_system/data
REVIEW_ALLOWED_ORIGINS=
REVIEW_LOGIN_FAILURE_LIMIT=5
REVIEW_LOGIN_WINDOW_MINUTES=15
REVIEW_IMAGE_TAG=local
